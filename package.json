{
  "name": "gentlevie",
  "version": "1.0.0",
  "private": true,
  "description": "GentleVie — Next.js ve TypeScript ile editoryal portföy projesi",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "check:deploy": "node --env-file-if-exists=.env.local --import tsx scripts/check-deploy.ts",
    "deploy": "npx vercel@latest --prod",
    "deploy:preview": "npx vercel@latest"
  },
  "dependencies": {
    "better-auth": "^1.7.17",
    "mongodb": "7.8.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
