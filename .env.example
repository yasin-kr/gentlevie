# Public production URL, for canonical links, sharing and origin checks.
# During local development use http://localhost:3000.
SITE_URL=http://localhost:3000

# Server-only MongoDB Atlas connection; never prefix secrets with NEXT_PUBLIC_.
MONGODB_URI=
MONGODB_DB=gentlevie

# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=

# These two values are PUBLIC on /gizlilik and required before accepting sign-ups.
SITE_OWNER_NAME=gentle vie
PRIVACY_CONTACT_EMAIL=gentlevie@gmail.com

# Verified owner account allowed into /yonetim. Public sign-up cannot grant admin rights.
ADMIN_EMAIL=gentlevie@gmail.com

# Generate a DIFFERENT 32+ character secret with the command above.
BETTER_AUTH_SECRET=

# Transactional email. Gmail requires an app password, never your normal password.
# You may substitute your own SMTP service. Keep these values server-side.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gentlevie@gmail.com
SMTP_PASS=
SMTP_FROM=gentle vie <gentlevie@gmail.com>
